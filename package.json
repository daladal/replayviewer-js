{
  "name": "replayviewer-js",
  "version": "1.0.0",
  "description": "Render osu! replays in the browser — parsers, judgement engine, and canvas renderer for all four rulesets",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daladal/replayviewer-js.git"
  },
  "homepage": "https://github.com/daladal/replayviewer-js#readme",
  "bugs": "https://github.com/daladal/replayviewer-js/issues",
